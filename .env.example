# Agent-Alfred 环境变量模板。
# 复制为 .env 后自行填写；本文件只放变量名，值必须留空，切勿写入真实密钥。
# 未使用的项保持空即可（连接四态里的「未配置」）。

# OpenCode Go（切片①默认 provider；base 是 zen/go/v1，不是按量版 zen/v1）
OPENCODE_API_KEY=

# 状态目录根。必须是绝对路径；缺省为 ~/.agent_alfred/
AGENT_ALFRED_HOME=

# ── 运行配置（优先级：CLI 旗标 > 这里 > 内置默认；解析 fail-fast，非法值启动即报错）──
# 每 Run 的 Step 上限（一个 Step = 一次模型响应 + 其后的一批工具）。0 合法：不发生模型请求。
AGENT_ALFRED_MAX_STEPS=
# 单次模型请求的最大输出 token；留空 = 不限制
AGENT_ALFRED_MAX_TOKENS=
# 单个 Run 的整体墙钟预算（秒，含全部重试与回退）；留空 = 不限制
AGENT_ALFRED_OVERALL_DEADLINE_S=
# 一次真实网络往返的超时（秒）；实际传给 Adapter 的是 min(剩余 overall, 此值)
AGENT_ALFRED_PER_ATTEMPT_TIMEOUT_S=
# 是否先尝试流式（1/true/yes/on 或 0/false/no/off）
AGENT_ALFRED_STREAM=
# 流式失败是否允许回退到非流式
AGENT_ALFRED_STREAM_FALLBACK=
# 工作记忆取最近多少轮（0 合法：不带历史）
AGENT_ALFRED_WORKING_MEMORY_ROUNDS=
# 人格文件路径（UTF-8、非空；内容逐字作为人格）。未设置时用内置默认人格。
# 系统提示词 = 人格 + 当前本地时间，按请求现场拼装，永不写入会话记录或运行转录。
AGENT_ALFRED_PERSONA_FILE=

# Anthropic 原生 messages 适配器
ANTHROPIC_API_KEY=

# OpenAI 兼容适配器（官方 OpenAI 端点）
OPENAI_API_KEY=

# DeepSeek（OpenAI 兼容）
DEEPSEEK_API_KEY=

# xAI（OpenAI 兼容）
XAI_API_KEY=

# Tavily web_search（可选集成；无 SDK，走标准库 HTTP）
TAVILY_API_KEY=

# 每类记忆最多召回条数（正整数，默认 5）
AGENT_ALFRED_PER_STORE_LIMIT=
# 每类序列化参考资料的 Unicode 码点上限（正整数，默认 4000）
AGENT_ALFRED_PER_STORE_CHARACTER_BUDGET=
# Skill 自动选择与记忆检索门各自的模型预算秒数（有限正数，默认 5；受 Run 总时限约束）
AGENT_ALFRED_GATE_MODEL_BUDGET_S=

# Complete normalized input characters (not provider token capacity).
AGENT_ALFRED_INPUT_CHARACTER_LIMIT=
# Empty inherits the general input limit.
AGENT_ALFRED_GATE_INPUT_CHARACTER_LIMIT=

# 提炼：未处理完整 chat Run 阈值（正整数，默认 10）
AGENT_ALFRED_CONSOLIDATION_SOURCE_THRESHOLD=
# 提炼系统 Run 执行时限秒（有限正数，默认 60）
AGENT_ALFRED_CONSOLIDATION_DEADLINE_S=
# 旧语义候选条数上限（正整数，默认 20）
AGENT_ALFRED_CONSOLIDATION_CANDIDATE_COUNT=
# 旧语义候选组 Unicode 码点上限（正整数，默认 16000）
AGENT_ALFRED_CONSOLIDATION_CANDIDATE_CHARS=

# P2 合成环境运行时变量：由独立部署管理员通过 infra/p2 注入。
# 普通本地产品无需填写；这里的空值不授予部署或在线执行许可。
AWS_REGION=
P2_SYNTHETIC_ONLY=
P2_DEPLOYMENT_ACTIVE=
P2_STOP_DISPATCH=
P2_JOB_ID=
P2_ATTEMPT_ID=
P2_PROBE_ONLY=
P2_PROBE_ROLE=
P2_PROBE_TARGETS=
