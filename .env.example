# Agent-Alfred 环境变量模板。
# 复制为 .env 后自行填写；本文件只放变量名，值必须留空，切勿写入真实密钥。
# 未使用的项保持空即可（连接四态里的「未配置」）。

# OpenCode Go（切片①默认 provider；base 是 zen/go/v1，不是按量版 zen/v1）
OPENCODE_API_KEY=

# 状态目录根。必须是绝对路径；缺省为 ~/.agent_alfred/
AGENT_ALFRED_HOME=

# ── 运行配置（优先级：CLI 旗标 > 这里 > 内置默认；解析 fail-fast，非法值启动即报错）──
# 每 Run 的 Step 上限（一个 Step = 一次模型响应 + 其后的一批工具）。0 合法：不发生模型请求。
AGENT_ALFRED_MAX_STEPS=
# 单次模型请求的最大输出 token；留空 = 不限制
AGENT_ALFRED_MAX_TOKENS=
# 单个 Run 的整体墙钟预算（秒，含全部重试与回退）；留空 = 不限制
AGENT_ALFRED_OVERALL_DEADLINE_S=
# 一次真实网络往返的超时（秒）；实际传给 Adapter 的是 min(剩余 overall, 此值)
AGENT_ALFRED_PER_ATTEMPT_TIMEOUT_S=
# 是否先尝试流式（1/true/yes/on 或 0/false/no/off）
AGENT_ALFRED_STREAM=
# 流式失败是否允许回退到非流式
AGENT_ALFRED_STREAM_FALLBACK=
# 工作记忆取最近多少轮（0 合法：不带历史）
AGENT_ALFRED_WORKING_MEMORY_ROUNDS=
# 人格文件路径（UTF-8、非空；内容逐字作为人格）。未设置时用内置默认人格。
# 系统提示词 = 人格 + 当前本地时间，按请求现场拼装，永不写入会话记录或运行转录。
AGENT_ALFRED_PERSONA_FILE=

# Anthropic 原生 messages 适配器
ANTHROPIC_API_KEY=

# OpenAI 兼容适配器（官方 OpenAI 端点）
OPENAI_API_KEY=

# DeepSeek（OpenAI 兼容）
DEEPSEEK_API_KEY=

# xAI（OpenAI 兼容）
XAI_API_KEY=

# Tavily web_search（可选集成；无 SDK，走标准库 HTTP）
TAVILY_API_KEY=
