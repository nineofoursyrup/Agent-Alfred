  const captures = [];
  await page.getByRole('heading',{name:'Graph',exact:true}).waitFor();
  for (const [width,height] of [[1440,900],[1280,800],[390,844],[320,800]]) {
    await page.setViewportSize({width,height});
    const file = `reference-graph-${width}x${height}.png`;
    await page.screenshot({path:`/Users/nineofour/Agent-Alfred-v07/.scratch/v07/validation-20261023/captures/${file}`});
    captures.push({file,width,height,geometry:await page.evaluate(()=>({viewport:[innerWidth,innerHeight],dpr:devicePixelRatio,main:document.querySelector('main').getBoundingClientRect().width,navigation:document.querySelector('nav').getBoundingClientRect().width,document:[document.documentElement.clientWidth,document.documentElement.scrollWidth]})),snapshot:await page.locator('main').ariaSnapshot()});
  }
  return {url:page.url(),port:18078,browser:page.context().browser().version(),referenceView:'Graph',captures};
}
)(page);
